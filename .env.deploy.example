# Copy values from your local .env — do not commit real secrets.
# Used by: docker compose up

# API keys
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
FIREWORKS_API_KEY=
ASR_LANGUAGE=multi

SUPER_PASS_MODEL=gpt-4.1-mini
CER_MODEL=gpt-4.1-mini
SOAP_MODEL=gpt-4.1-mini
PHASE2_MODEL=gpt-4.1-mini
LLM_JUDGE_MODEL=gpt-4.1-nano
BATCH_INTENT_MODEL=gpt-4.1-nano

# Clinic Postgres (on the host machine when using Docker Desktop)
# Inside compose, PGHOST is overridden to host.docker.internal
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=super_pass
PGUSER=vivek
PGPASSWORD=
CLINIC_ID=1

GROUNDING_AUTO_BIND_THRESHOLD=0.85
CATEGORY_HARD_GATE_RECALL_FALLBACK=true

# Publish port on the host
VETAI_PORT=8501

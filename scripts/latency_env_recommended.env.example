# Quality-safe latency settings (no model downgrades — keep gpt-4.1-mini)
# Copy relevant lines into .env after benchmarking with scripts/compare_asr_models.py

# ASR (benchmark nova-3 vs nova-2 before changing)
ASR_PROVIDER=deepgram
ASR_MODEL=nova-3
ASR_LANGUAGE=multi
FAST_TRANSCRIPTION=true

# Pre-upload 16 kHz mono WAV (smaller Deepgram upload; default on)
ASR_PREP_WAV=true

# Parallel chunk ASR for long audio (benchmark stitched WER before enabling in prod)
# ASR_PARALLEL_CHUNKS=true
# ASR_CHUNK_MINUTES=3
# ASR_CHUNK_OVERLAP_SEC=2
# ASR_PARALLEL_MAX_WORKERS=4
# ASR_PARALLEL_MIN_DURATION_SEC=300

# Doctor UI / pipeline parallelism (no quality impact)
PHASE2_BLOCKING=false
PHASE2_START_WITH_SOAP_READY=true
TARGET_60S=true
CHUNK_PARALLEL_ENABLED=true

# Fireworks streaming overlap (optional; not default)
# TRANSCRIPTION_STREAMING=true
# ASR_STREAMING_OVERLAP=true
